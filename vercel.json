{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/feed/google.xml",
      "destination": "/api/catalogus?actie=feed&kanaal=google"
    },
    {
      "source": "/feed/meta.xml",
      "destination": "/api/catalogus?actie=feed&kanaal=meta"
    },
    {
      "source": "/poster/:id",
      "destination": "/api/poster?id=:id"
    },
    {
      "source": "/etsy/terug",
      "destination": "/api/kanalen?actie=etsy-terug"
    },
    {
      "source": "/tiktok/terug",
      "destination": "/api/kanalen?actie=tiktok-terug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(admin|admin.html|bestelling.html)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </?lang=en>; rel=\"alternate\"; hreflang=\"en\", </>; rel=\"alternate\"; hreflang=\"nl\", </feed/google.xml>; rel=\"alternate\"; type=\"application/rss+xml\"; title=\"SKIFFA product feed\", </.well-known/api-catalog>; rel=\"api-catalog\", </voorwaarden.html>; rel=\"terms-of-service\", </privacy.html>; rel=\"privacy-policy\""
        },
        {
          "key": "Vary",
          "value": "Accept"
        }
      ]
    },
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ],
  "functions": {
    "api/kanalen.js": {
      "maxDuration": 60
    }
  }
}
