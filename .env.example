# Kopieer naar .env (lokaal) of zet als Environment Variables in Vercel.
# Zolang deze leeg/afwezig zijn, draait de site op de content in index.html (exact het ontwerp).
# Zet ze pas als er een CMS-site + token voor Skiffa is aangemaakt in /admin/platform.

CMS_URL=https://linkandlead.nl
CMS_TOKEN=cms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Bestellen (api/bestel.js) — kies één; zonder beide opent de site een mail met de bestelling ----
# 1) Mollie (iDEAL, Bancontact, kaart). API-key uit het Mollie-dashboard (test_… om te testen).
MOLLIE_API_KEY=live_xxx
# 2) Resend: met Mollie de mail bij een betaalde bestelling; zonder Mollie de bestelling zelf per mail.
RESEND_API_KEY=re_xxx
RESEND_FROM=Skiffa <bestellingen@skiffa.nl>
BESTEL_EMAIL=hallo@skiffa.nl
# Optioneel: vaste basis-URL voor de terugkeer na betalen (anders de host van het verzoek).
SITE_URL=https://skiffa.nl
