# Kopieer naar .env (lokaal) of zet als Environment Variables in Vercel (Production + Preview).
# Alles is optioneel: wat ontbreekt valt netjes terug (zie README).

# ---- CMS (teksten) ----
CMS_URL=https://linkandlead.nl
CMS_TOKEN=cms_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Administratie (bestellingen, facturen, beheer op /admin) ----
# Supabase-project met de migratie uit supabase/migrations. De service-role-key blijft op de server.
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Inloggen op /admin: minstens 12 tekens. ADMIN_GEHEIM (optioneel) ondertekent de sessiecookie.
ADMIN_WACHTWOORD=kies-een-lang-wachtwoord
ADMIN_GEHEIM=lange-willekeurige-tekenreeks

# ---- Betalen ----
# Mollie (iDEAL, Bancontact, kaart). test_… om te testen, live_… voor echt.
MOLLIE_API_KEY=live_xxx

# ---- Mails (bevestiging, verzonden, terugbetaald, contactformulier) ----
RESEND_API_KEY=re_xxx
RESEND_FROM=Skiffa <bestellingen@skiffa.store>
BESTEL_EMAIL=hallo@skiffa.nl

# ---- Prodigi (drukken en verzenden; instellingen in /admin → kanalen) ----
# Sandbox-sleutel om te testen (er wordt niets gedrukt) en de live-sleutel. Prodigi-dashboard → Settings → API.
PRODIGI_SANDBOX_API_KEY=
PRODIGI_API_KEY=

# ---- Drukker (optioneel; alleen gebruikt als Prodigi uit staat) ----
# Na elke betaalde bestelling gaat hier een drukopdracht heen: verzendadres + links naar de drukbestanden.
DRUKKER_EMAIL=

# ---- Bedrijfsgegevens op facturen en in mails ----
BEDRIJF_NAAM=Skiffa
BEDRIJF_ADRES=Keizerstraat 100, 2586 AZ Den Haag
BEDRIJF_KVK=12345678
BEDRIJF_BTW=NL000000000B01
BEDRIJF_IBAN=NL00BANK0000000000

# ---- Verkoopkanalen (Beheer → Kanalen; alles staat standaard uit en in proefmodus) ----
# Automatische synchronisatie (GitHub Actions, elke 15 min): zelfde waarde als repository-secret.
CRON_SECRET=lange-willekeurige-tekenreeks-min-16
# bol.com: partnerplatform → Instellingen → API-instellingen (Retailer API, eigen verzending).
BOL_CLIENT_ID=
BOL_CLIENT_SECRET=
# Etsy: etsy.com/developers → Create a new app; callback-URL https://skiffa.store/etsy/terug.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Amazon: Seller Central → Apps en services → Apps ontwikkelen (SP-API, rol Inventory/Orders).
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_SELLER_ID=

# Basis-URL voor links in mails en de terugkeer na betalen.
SITE_URL=https://skiffa.store
